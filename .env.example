# CouchDB server-side configuration
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_DATABASE=retail_shop
COUCHDB_USERNAME=your_couchdb_username
COUCHDB_PASSWORD=your_couchdb_password
COUCHDB_TIMEOUT_MS=5000

# Generate a random value with at least 32 characters. Keep it server-side.
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
SESSION_TTL_SECONDS=28800

# Used only by `npm run admin:init`; never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Quản trị viên
ADMIN_PASSWORD=replace_with_a_strong_admin_password
